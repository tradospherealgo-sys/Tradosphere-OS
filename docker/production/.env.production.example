# ─── Tradosphere OS — Production Environment ─────────────────────────────
# Copy this to .env, fill in your values, never commit the real .env file.
#
# Required (MUST be set):
#   DOMAIN, JWT_SECRET, POSTGRES_PASSWORD
#
# Required for real market data (when available):
#   SMC_GLOBAL_API_KEY, SMC_GLOBAL_API_SECRET, etc.
#
# Required for AI agents (when connected to an LLM):
#   AI_PROVIDER_API_KEY

# ─── Domain ─────────────────────────────────────────────────────────────
DOMAIN=tradosphere.example.com

# ─── Database ───────────────────────────────────────────────────────────
POSTGRES_USER=tradosphere
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_SECURE_PASSWORD
POSTGRES_DB=tradosphere_os

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_REAL_SECRET_AT_LEAST_64_CHARS

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=120
GATEWAY_RATE_LIMIT_PER_MIN=300

# ─── Market Data ────────────────────────────────────────────────────────
MARKET_DATA_SYMBOLS=RELIANCE,TCS,INFY

# ─── Paper Trading ──────────────────────────────────────────────────────
PORTFOLIO_STARTING_CASH=100000

# ─── Docker Image Configuration ─────────────────────────────────────────
# Uncomment if using a private container registry:
# REGISTRY=ghcr.io
# IMAGE_NAMESPACE=tradosphere
# IMAGE_TAG=latest

# ─── SMC Global Broker (when API becomes available) ─────────────────────
# SMC_GLOBAL_API_KEY=
# SMC_GLOBAL_API_SECRET=
# SMC_GLOBAL_CLIENT_ID=
# SMC_GLOBAL_BASE_URL=

# ─── AI Provider (when connecting to an LLM) ────────────────────────────
# AI_PROVIDER_API_KEY=
