# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB are consumed two ways: directly
# by docker-compose.yml's postgres service (the official postgres image reads
# these three exact env var names itself, not a connection string) and
# interpolated into DATABASE_URL below for local (non-Docker) runs.
# docker-compose.yml recomposes its own in-container DATABASE_URL from these
# same three values pointed at the `postgres` service hostname instead of
# localhost -- see the comment above the `auth` service's DATABASE_URL there.
# If you change the password here, update DATABASE_URL's embedded copy too;
# docker-compose does not parse one back out of the other.
POSTGRES_USER=tradosphere
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tradosphere_os
DATABASE_URL=postgresql://tradosphere:changeme@localhost:5432/tradosphere_os
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=changeme
AUTH_SERVICE_PORT=4001
# Access/refresh token lifetimes (15m / 30d) are currently fixed constants in
# packages/auth/src/jwt.ts, not read from env -- these two lines describe
# that fixed behavior rather than configuring it. Wiring them through
# services/auth is parked; see EXECUTION_BOOK.md Parked Items.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Task D (Sprint 5.5): read by services/auth/src/index.ts's
# getEnvNumber('RATE_LIMIT_PER_MIN', 120) to configure the Redis-backed rate
# limiter on every auth endpoint (max requests per 60s window, per caller
# IP). Originally listed under "Gateway" below before any service actually
# read it; moved here now that the auth service is the real consumer. If a
# future apps/api gateway needs its own independent limit, give it a
# distinctly-named variable rather than sharing this one.
RATE_LIMIT_PER_MIN=120

# ---- Education ----
# Sprint 7: services/education has no rate-limit dependency (see its
# package.json / app.ts comments) so it needs nothing else here beyond its
# port -- no RATE_LIMIT_PER_MIN-equivalent, no REDIS_URL dependency.
EDUCATION_SERVICE_PORT=4003

# ---- SMC Global Broker ----
SMC_GLOBAL_API_KEY=
SMC_GLOBAL_API_SECRET=
SMC_GLOBAL_CLIENT_ID=
SMC_GLOBAL_BASE_URL=

# ---- AI ----
AI_PROVIDER_API_KEY=

# ---- Gateway ----
API_PORT=4000
WEB_PORT=3000
