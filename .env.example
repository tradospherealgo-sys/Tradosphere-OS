# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB are consumed two ways: directly
# by docker-compose.yml's postgres service (the official postgres image reads
# these three exact env var names itself, not a connection string) and
# interpolated into DATABASE_URL below for local (non-Docker) runs.
# docker-compose.yml recomposes its own in-container DATABASE_URL from these
# same three values pointed at the `postgres` service hostname instead of
# localhost -- see the comment above the `auth` service's DATABASE_URL there.
# If you change the password here, update DATABASE_URL's embedded copy too;
# docker-compose does not parse one back out of the other.
POSTGRES_USER=tradosphere
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tradosphere_os
DATABASE_URL=postgresql://tradosphere:changeme@localhost:5432/tradosphere_os
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=changeme
AUTH_SERVICE_PORT=4001
# Access/refresh token lifetimes (15m / 30d) are currently fixed constants in
# packages/auth/src/jwt.ts, not read from env -- these two lines describe
# that fixed behavior rather than configuring it. Wiring them through
# services/auth is parked; see EXECUTION_BOOK.md Parked Items.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Task D (Sprint 5.5): read by services/auth/src/index.ts's
# getEnvNumber('RATE_LIMIT_PER_MIN', 120) to configure the Redis-backed rate
# limiter on every auth endpoint (max requests per 60s window, per caller
# IP). Originally listed under "Gateway" below before any service actually
# read it; moved here now that the auth service is the real consumer. If a
# future apps/api gateway needs its own independent limit, give it a
# distinctly-named variable rather than sharing this one.
RATE_LIMIT_PER_MIN=120

# ---- Market Data ----
# Sprint 3: services/market-data has no rate-limit dependency (no
# @fastify/rate-limit registration in its app.ts) so it needs nothing here
# beyond its own port -- same reasoning as Education/Portfolio/Analytics
# below. Read by index.ts's getEnvNumber('MARKET_DATA_SERVICE_PORT', 4002).
# Never wired into .env.example or docker-compose.yml until Sprint 9 Task
# 9.1 needed a documented forward target for the gateway's market-data
# proxy route -- leave unset to keep the 4002 code default.
MARKET_DATA_SERVICE_PORT=4002
# Comma-separated symbol list read by index.ts's
# getEnv('MARKET_DATA_SYMBOLS', 'RELIANCE,TCS,INFY') to seed live ingestion
# on boot. Optional -- leave unset to keep that same three-symbol default.
MARKET_DATA_SYMBOLS=RELIANCE,TCS,INFY

# ---- Education ----
# Sprint 7: services/education has no rate-limit dependency (see its
# package.json / app.ts comments) so it needs nothing else here beyond its
# port -- no RATE_LIMIT_PER_MIN-equivalent, no REDIS_URL dependency.
EDUCATION_SERVICE_PORT=4003

# ---- Portfolio ----
# Sprint 8.3: services/portfolio has no rate-limit dependency either (same
# reasoning as Education above) -- just its own port plus an optional
# starting-cash override. PORTFOLIO_STARTING_CASH feeds
# getEnvNumber('PORTFOLIO_STARTING_CASH', 100_000) in src/cash.ts
# (DEFAULT_STARTING_CASH) -- every paper account starts from this same
# figure since there is no per-user funding/deposit flow yet (Decision D17).
# Leave it unset to keep the 100_000 code default.
PORTFOLIO_SERVICE_PORT=4004
PORTFOLIO_STARTING_CASH=100000

# ---- Analytics ----
# Sprint 8.4: services/analytics has no rate-limit dependency either (same
# reasoning as Education/Portfolio above) and no optional numeric override
# like PORTFOLIO_STARTING_CASH -- every stat is computed on demand from
# journal_entries/portfolio_snapshots (Decision D18), so it needs nothing
# else here beyond its own port.
ANALYTICS_SERVICE_PORT=4005

# ---- SMC Global Broker ----
SMC_GLOBAL_API_KEY=
SMC_GLOBAL_API_SECRET=
SMC_GLOBAL_CLIENT_ID=
SMC_GLOBAL_BASE_URL=

# ---- AI ----
AI_PROVIDER_API_KEY=

# ---- Gateway ----
API_PORT=4000
WEB_PORT=3000
# Task 9.15/Decision D19 (4): the gateway's own independent rate limit --
# deliberately NOT RATE_LIMIT_PER_MIN above, which is reserved for
# services/auth specifically (see that variable's own comment). Read by
# apps/api/src/index.ts's getEnvNumber('GATEWAY_RATE_LIMIT_PER_MIN', 300).
# Optional -- leave unset to keep the 300-per-minute code default.
GATEWAY_RATE_LIMIT_PER_MIN=300
# Task 9.15: base URLs the gateway's proxy layer (task 9.1) forwards to for
# the five services that already have their own HTTP surface. All five are
# optional -- apps/api/src/index.ts falls back to
# http://localhost:<that service's own *_SERVICE_PORT above> when unset,
# which is correct for local (non-Docker) dev where every service runs on
# localhost. docker-compose.yml overrides all five to the compose-network
# service hostnames (e.g. http://auth:4001) for the containerized `api`
# service, the same localhost-vs-service-name distinction every other
# service's DATABASE_URL/REDIS_URL already draws in that file.
AUTH_SERVICE_URL=http://localhost:4001
MARKET_DATA_SERVICE_URL=http://localhost:4002
EDUCATION_SERVICE_URL=http://localhost:4003
PORTFOLIO_SERVICE_URL=http://localhost:4004
ANALYTICS_SERVICE_URL=http://localhost:4005
